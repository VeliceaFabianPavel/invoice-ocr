<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.invoiceocr</groupId>
    <artifactId>invoice-ocr</artifactId>
    <version>1.1.2</version>
    <packaging>jar</packaging>

    <name>Invoice OCR</name>
    <description>Desktop application that reads invoice images and extracts their fields.</description>

    <inceptionYear>2026</inceptionYear>

    <!--
        Proprietary. Not open source: no licence to use, copy, modify, build or
        distribute this code is granted at present. See LICENSE at the project
        root. Third-party components bundled by the shade plugin keep their own
        licences; those are listed in THIRD-PARTY-NOTICES.md.
    -->
    <licenses>
        <license>
            <name>Proprietary — All Rights Reserved</name>
            <url>https://github.com/VeliceaFabianPavel/invoice-ocr/blob/main/LICENSE</url>
            <distribution>manual</distribution>
            <comments>
                All rights reserved. No permission is granted to use, copy,
                modify, build, run or distribute this software. Written
                permission from the copyright holder is required for any use.
            </comments>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Fabian Pavel Velicea</name>
            <email>fabian.velicea@student.unitbv.ro</email>
            <roles><role>author</role></roles>
        </developer>
    </developers>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <main.class>com.invoiceocr.app.InvoiceOcrApplication</main.class>

        <tess4j.version>5.11.0</tess4j.version>
        <junit.version>5.10.2</junit.version>
        <surefire.version>3.2.5</surefire.version>
        <shade.version>3.5.2</shade.version>
    </properties>

    <dependencies>
        <!-- JNA binding over libtesseract; the native libraries ship with the artifact. -->
        <dependency>
            <groupId>net.sourceforge.tess4j</groupId>
            <artifactId>tess4j</artifactId>
            <version>${tess4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>invoice-ocr</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>

            <!-- Produces a self-contained runnable jar: java -jar target/invoice-ocr.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${shade.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer
                                    implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
